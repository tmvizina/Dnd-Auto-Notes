{
  "name": "dnd-auto-notes",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Turns a Craig recording and a Roll20 log into a D&D session log.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "app/*"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "campaign:init": "node tools/campaign-init.mjs",
    "clean": "tsc -b tsconfig.build.json --clean",
    "dev": "npm run dev --workspace @dnd/desktop",
    "fixture:generate": "node tools/generate-fixture.mjs --out test/fixtures/session-synthetic",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "pipeline": "npm run --silent start --workspace @dnd/cli --",
    "session:new": "npm run --silent start --workspace @dnd/cli -- session new",
    "sidecar:setup": "node tools/setup-sidecar.mjs",
    "test": "vitest run --config vitest.config.mjs",
    "test:all": "npm run test && npm run test:py",
    "test:py": "node tools/run-pytest.mjs",
    "tickets": "node tools/tickets.mjs",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@dnd/cli": "*",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.5",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
